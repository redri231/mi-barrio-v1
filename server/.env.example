# Use Render's Internal Database URL when this API runs in the same Render region.
# For local development use the External Database URL with ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
PORT=10000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
OTP_PROVIDER=disabled
# Required in every environment to sign access tokens.
AUTH_TOKEN_SECRET=
# Required only when OTP_PROVIDER=twilio. Keep secrets server-side.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: random secret (32+ chars) for protected residency/content/SOS review routes.
VERIFICATION_REVIEW_TOKEN=
